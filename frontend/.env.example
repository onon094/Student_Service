# ============================================================
# Dify 应用 API Key（复制本文件为 .env.local 再填）
# ------------------------------------------------------------
# 1. cp .env.example .env.local
# 2. 填入你自己的 Dify 应用 Key
# 3. 重新构建：npm run build
#
# 注意：Vite 只读取 VITE_ 前缀的变量；.env.local 已被 .gitignore 排除，不会提交。
# ============================================================

# 学生端「留学生智能管家」
VITE_DIFY_STUDENT=

# 员工端「员工业务助手」（老师、管理员默认复用这一个）
VITE_DIFY_EMPLOYEE=

# 官网右下角「在线客服」
VITE_DIFY_GUEST=

# 可选：老师 / 管理员用独立应用时再填，不填则复用上面的员工 Key
# VITE_DIFY_TEACHER=
# VITE_DIFY_ADMIN=
