# 复制为 .env 后填写；不要把 .env 提交到 Git

# SQLite 数据库文件（默认 backend/yuejiao.db，一般不用改）
# DB_PATH=./yuejiao.db

# NL2SQL 用哪个模型供应商：dashscope / deepseek / zhipu / custom
# 改这一行就能换供应商，代码不用动
NL2SQL_PROVIDER=dashscope

# ---- 方案 A：智谱 GLM（推荐，glm-4-flash 永久免费）----
# 注册 https://open.bigmodel.cn/ → 右上角 API Key → 复制
# 用法：NL2SQL_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 方案 B：阿里云百炼（通义千问）----
# 控制台 https://bailian.console.aliyun.com/ → API-KEY 管理 → 创建
# 每个模型 100 万 token 免费，90 天；用完会报 FreeTierOnly
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 方案 C：DeepSeek（可复用 Dify 里已配好的那把 Key）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 方案 D：任意 OpenAI 兼容端点（硅基流动 / 火山方舟 / 本地 Ollama）----
# 用法：NL2SQL_PROVIDER=custom + 填下面两行 + 最后的 NL2SQL_MODEL
NL2SQL_API_KEY=
NL2SQL_BASE_URL=

# 模型名；不填会自动用当前供应商的默认模型
# （dashscope=qwen-plus，deepseek=deepseek-chat，zhipu=glm-4-flash）
NL2SQL_MODEL=qwen-plus
# 单次模型调用超时（秒），不要设太大：Dify 工具 30~60 秒就判超时
NL2SQL_TIMEOUT=20
# 整个请求的总时间预算（秒），超了就不再重试生成 SQL
NL2SQL_TIME_BUDGET=40
# 演示降级开关：默认 0（关闭）。
# 开成 1 会用预置 SQL 兜底，但关键词匹配可能答错问题，答辩有风险，别乱开。
NL2SQL_FALLBACK=0

# ===== 认证（新增）=====
# 令牌签名密钥：随机长字符串，正式环境必须自行设置（改了会让已发令牌全部失效）
SECRET_KEY=请替换成随机字符串
# 令牌有效期（小时）
TOKEN_TTL_HOURS=12
# 服务令牌：给 Dify 自定义工具调用后端用；Dify 工具里配 Authorization: Bearer <该值>
SERVICE_TOKEN=请替换成随机字符串（以 svc- 开头便于识别）
# 演示初始口令：种子账号的密码，首次启动会写入哈希
DEFAULT_DEMO_PASSWORD=123456
